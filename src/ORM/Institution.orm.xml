<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
  <entity name="App\Entity\Institution" table="institutions">

    <id name="id" type="integer" column="id">
      <generator strategy="AUTO"/>
    </id>

    <field name="name" column="name" type="string" nullable="false" />
    <field name="description" column="description" type="string" nullable="false" />

    <one-to-many field="groups" target-entity="App\Entity\Group" mapped-by="institution" orphan-removal="false" >
      <cascade>
        <cascade-persist/>
        <cascade-remove/>
      </cascade>
      <order-by>
        <order-by-field name="name" direction="ASC" />
      </order-by>
    </one-to-many>

  </entity>
</doctrine-mapping>
