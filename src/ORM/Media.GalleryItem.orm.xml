<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
    <entity
        name="App\Entity\Media\GalleryItem"
        table="media__gallery_item"
    >

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <many-to-one field="gallery" target-entity="App\Entity\Media\Gallery" inversed-by="galleryItems">
            <cascade>
                <cascade-persist/>
            </cascade>
            <join-column name="gallery_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <one-to-one field="media" target-entity="App\Entity\Media\Media" orphan-removal="true" fetch="EAGER" >
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
            <join-column name="media_id" referenced-column-name="id" nullable="true" on-delete="CASCADE" />
        </one-to-one>
    </entity>
</doctrine-mapping>
