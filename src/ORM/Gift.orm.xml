<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
  <entity
          name="App\Entity\Gift"
          table="gifts"
          repository-class="App\Repository\GiftRepository"
  >

    <id name="id" type="integer" column="id">
      <generator strategy="AUTO"/>
    </id>

    <unique-constraints>
      <unique-constraint name="unique_gifts_promotion_child" columns="promotion_id,child_id" />
    </unique-constraints>

    <field name="description" column="description" type="text" nullable="false" />
    <field name="giftStatusEnum" column="gift_status_enum" type="string" enum-type="App\Enum\GiftStatusEnum" nullable="false" />

    <many-to-one field="promotion" target-entity="App\Entity\Promotion">
      <cascade>
        <cascade-persist/>
      </cascade>
      <join-column name="promotion_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
    </many-to-one>

    <many-to-one field="child" target-entity="App\Entity\Child">
      <cascade>
        <cascade-persist/>
      </cascade>
      <join-column name="child_id" referenced-column-name="id" nullable="false" on-delete="RESTRICT" />
    </many-to-one>

    <many-to-one field="user" target-entity="App\Entity\User">
      <join-column name="user_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
    </many-to-one>

    <field name="createdAt" column="created_at" type="datetime" nullable="false" />
    <field name="updatedAt" column="updated_at" type="datetime" nullable="false" />
    <lifecycle-callbacks>
      <lifecycle-callback type="prePersist" method="prePersistTimestampable"/>
      <lifecycle-callback type="preUpdate" method="preUpdateTimestampable"/>
    </lifecycle-callbacks>

  </entity>
</doctrine-mapping>
